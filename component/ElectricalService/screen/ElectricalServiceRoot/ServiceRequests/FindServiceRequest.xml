<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false">

    <transition name="findServiceRequest"><default-response url="."/></transition>
    <transition name="editServiceRequest"><default-response url="../EditServiceRequest"/></transition>
    <transition name="createServiceRequest" authz-action="create">
        <service-call name="ElectricalService.ElectricalServiceServices.create#ServiceRequest"/>
        <default-response url="."/></transition>

    <transition-include name="searchPartyList" location="component://SimpleScreens/template/party/PartyForms.xml"/>

    <widgets>
        <container-dialog id="NewServiceRequestContainer" button-text="New Service Request">
            <form-single name="NewServiceRequestForm" transition="createServiceRequest">
                <field name="customerPartyId"><default-field title="Customer">
                    <drop-down allow-empty="false"><dynamic-options transition="searchPartyList" server-search="true" min-length="2"
                            parameter-map="[roleTypeId:'Customer']"/></drop-down>
                </default-field></field>
                <field name="priority"><default-field>
                    <drop-down no-current-selected-key="5"><option key="1"/><option key="2"/><option key="3"/><option key="4"/>
                        <option key="5"/><option key="6"/><option key="7"/><option key="8"/><option key="9"/></drop-down>
                </default-field></field>
                <field name="description"><default-field title="Description"><text-area rows="6"/></default-field></field>
                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <form-list name="ListServiceRequests" list="serviceRequestList" skip-form="true" header-dialog="true"
                select-columns="true" saved-finds="true" show-page-size="true">
            <entity-find entity-name="ElectricalService.ElectricalServiceRequestDetail" list="serviceRequestList">
                <econdition field-name="requestTypeEnumId" value="RtElecService"/>
                <search-form-inputs default-order-by="priority,requestedDate"/>
            </entity-find>

            <field name="statusId">
                <header-field title="Status" show-order-by="true">
                    <widget-template-include location="component://webroot/template/screen/BasicWidgetTemplates.xml#statusDropDown">
                        <set field="statusTypeId" value="ElecServiceRequest"/><set field="allowEmpty" value="true"/></widget-template-include>
                </header-field>
                <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field>
            </field>
            <field name="priority">
                <header-field show-order-by="true" title="Pri">
                    <drop-down allow-empty="true"><option key="1"/><option key="2"/><option key="3"/><option key="4"/>
                        <option key="5"/><option key="6"/><option key="7"/><option key="8"/><option key="9"/></drop-down>
                </header-field>
                <default-field><display/></default-field>
            </field>
            <field name="serviceRequestId">
                <header-field title="ID"><text-find size="10" hide-options="true"/></header-field>
                <default-field><link url="editServiceRequest" text="${serviceRequestId}" link-type="anchor"/></default-field>
            </field>
            <field name="requestedDate">
                <header-field title="Requested" show-order-by="true"><date-period allow-empty="true"/></header-field>
                <default-field><display/></default-field>
            </field>
            <field name="customerPartyId">
                <header-field title="Customer"><drop-down allow-empty="true">
                    <dynamic-options transition="searchPartyList" server-search="true" min-length="2" parameter-map="[roleTypeId:'Customer']"/>
                </drop-down></header-field>
                <default-field><display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/></default-field>
            </field>
            <field name="technicianPartyId">
                <header-field title="Technician"><drop-down allow-empty="true">
                    <dynamic-options transition="searchPartyList" server-search="true" min-length="2" parameter-map="[roleTypeId:'Worker']"/>
                </drop-down></header-field>
                <default-field><display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/></default-field>
            </field>
            <field name="description"><default-field><display/></default-field></field>

            <field name="submitButton"><header-field title="Find"><submit/></header-field></field>

            <form-list-column><field-ref name="priority"/></form-list-column>
            <form-list-column><field-ref name="requestedDate"/></form-list-column>
            <form-list-column><field-ref name="serviceRequestId"/><field-ref name="description"/></form-list-column>
            <form-list-column><field-ref name="statusId"/></form-list-column>
            <form-list-column><field-ref name="customerPartyId"/><field-ref name="technicianPartyId"/></form-list-column>
        </form-list>
    </widgets>
</screen>
